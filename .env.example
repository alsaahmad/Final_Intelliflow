# ===================================================
# INTELLIFLOW AI - ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Session Security Configuration
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET=intelliflow_super_secret_session_key_replace_in_production_32char_min
SESSION_SECURE=false
SESSION_MAX_AGE_MS=86400000

# Database Configuration
# Defaults to local SQLite database for zero-config local run, or a PostgreSQL connection string
DATABASE_PATH=./data/intelliflow.db
# DATABASE_URL=postgresql://user:password@localhost:5432/intelliflow

# OAuth 2.0 / OpenID Connect (OIDC) Configuration
# Supported providers: google, generic-oidc, dev
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-google-client-secret
OAUTH_ISSUER=https://accounts.google.com
OAUTH_REDIRECT_URI=http://localhost:5000/auth/callback
OAUTH_SCOPE=openid email profile

# Role Configuration
# Default role assigned to newly authenticated OAuth users if not pre-assigned
DEFAULT_DEMO_ROLE=CITIZEN

# Development / Sandbox Features
# Enables instant mock login personas (Citizen, Command Center, Municipal Engineer, Admin)
# Set to false in production!
ENABLE_DEV_MOCK_AUTH=true
