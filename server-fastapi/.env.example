# ===================================================
# INTELLIFLOW AI - FASTAPI BACKEND CONFIGURATION
# Phase 3A: Backend Foundation
# ===================================================

# Application Identity
APP_NAME=IntelliFlow AI FastAPI Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration (SQLAlchemy + asyncpg)
# Format: postgresql+asyncpg://user:password@localhost:5432/intelliflow_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelliflow_db

# JWT Security Configuration (Shared compatibility with Express backend)
# Must match JWT_SECRET used by Express server (port 5000)
JWT_SECRET=intelliflow_ai_jwt_secret_key_2026_smart_city_platform
JWT_ALGORITHM=HS256

# CORS Security (Allowed Client Origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:5000"]
